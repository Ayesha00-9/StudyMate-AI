# Address of the FastAPI backend.
# Copy this file to .env before running the frontend.
# Local development:  http://localhost:8000
# On Vercel:          your FastAPI Cloud URL (or /api if you proxy through vercel.json)
VITE_API_URL=http://localhost:8000

# ---- Social login (optional) ----
# Only the PUBLIC ids go here. Never put a client secret in the frontend.
# Leave them empty and the social buttons simply do not appear.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
