# Copy this file to .env and fill in your own values.
# NEVER put real keys or passwords in this file - it is committed to GitHub.

# OpenAI API key - get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# MongoDB Atlas connection string
MONGODB_URI=
DATABASE_NAME=studymate

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRE_HOURS=24

# AI models
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Folder where ChromaDB saves the vectors
CHROMA_DIR=chroma_store

# Frontend addresses allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Social login (optional) ----
# Google: from https://console.cloud.google.com/apis/credentials
# The frontend needs the CLIENT ID too (VITE_GOOGLE_CLIENT_ID in frontend/.env).
# The SECRET stays on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: from https://developers.facebook.com/apps
# The frontend needs the APP ID too (VITE_FACEBOOK_APP_ID in frontend/.env).
# The SECRET stays on the backend only - it is used to verify the login token.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
